model TeacherAttendance {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  teacherId        String        @db.ObjectId
  /// Clé de session : `YYYY-MM-DD:courseId` (une ligne par cours et par jour)
  sessionKey       String
  attendanceDate   String
  courseId         String?       @db.ObjectId
  scheduleId       String?       @db.ObjectId
  status           AbsenceStatus @default(PRESENT)
  source           String        @default("NFC")
  recordedByUserId String?       @db.ObjectId
  checkInAt        DateTime?
  /// Fin prévue du créneau (emploi du temps)
  checkOutAt       DateTime?
  /// Départ réel (2e pointage)
  actualCheckOutAt DateTime?
  /// Début prévu du créneau (résolu pour la date de session)
  scheduledStartAt DateTime?
  /// Fin prévue du créneau (alias de checkOutAt, dénormalisé pour rapports)
  scheduledEndAt   DateTime?
  /// Minutes de retard à l'arrivée (après début EDT + grâce)
  minutesLateStart   Int?
  /// Minutes d'avance à l'arrivée (avant début EDT)
  minutesEarlyStart  Int?
  /// Minutes de départ anticipé (avant fin EDT)
  minutesEarlyEnd    Int?
  /// Minutes au-delà de la fin EDT (départ tardif)
  minutesOvertimeEnd Int?
  /// Durée théorique du créneau (minutes)
  plannedMinutes   Int?
  /// Heures de cours décomptées (minutes effectives)
  teachingMinutes  Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  teacher          Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, sessionKey])
  @@index([attendanceDate])
  @@index([courseId])
  @@map("teacher_attendances")
}

/// Barème / poste de frais réutilisable (niveau, classe, programme)
model TuitionFeeCatalog {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String?                @db.ObjectId
  label            String
  academicYear     String?
  scope            TuitionFeeCatalogScope @default(BY_LEVEL)
  /// Niveau cible (ex. "6ème") si scope = BY_LEVEL ou filtre
  classLevel       String?
  classId          String?                @db.ObjectId
  class            Class?                 @relation(fields: [classId], references: [id])
  school           School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  /// Filière, option ou programme (texte libre)
  programLabel     String?
  feeType          SchoolFeeType          @default(TUITION)
  billingPeriod    TuitionBillingPeriod  @default(ONE_TIME)
  defaultAmount    Float
  /// Indice pour libellés de période (ex. "Trimestre" → T1, T2…)
  periodLabelHint  String?
  sortOrder        Int                    @default(0)
  isActive         Boolean                @default(true)
  /// Gabarit d'échéancier lié (tranches ≤ montant de la structure)
  scheduleTemplateId String?              @db.ObjectId
  scheduleTemplate   TuitionPaymentScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  tuitionFees TuitionFee[]

  @@index([schoolId])
  @@index([academicYear, scope, isActive])
  @@map("tuition_fee_catalog")
}

/// Gabarit d’échéancier (parts en % et décalage en jours depuis la date d’ancrage)
model TuitionPaymentScheduleTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  academicYear String?
  /// [{ "label": "Acompte", "percentOfTotal": 40, "dueOffsetDays": 0 }, …] somme des % = 100
  lines        Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tuitionFees TuitionFee[]
  catalogs     TuitionFeeCatalog[]

  @@map("tuition_payment_schedule_templates")
}

model TuitionFee {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String   @db.ObjectId
  academicYear  String
  period        String   // "Trimestre 1", "Semestre 1", "Année complète", etc.
  amount        Float    // Montant à payer (après remise) en FCFA
  dueDate       DateTime // Date d'échéance
  description   String?  // Description des frais
  isPaid        Boolean  @default(false)
  paidAt        DateTime?
  /// Émise / partiellement payée / payée
  billingStatus    TuitionBillingStatus @default(ISSUED)
  /// Libellé bourse ou aide (ex. « Bourse excellence »)
  scholarshipLabel String?
  feeType          SchoolFeeType         @default(OTHER)
  billingPeriod    TuitionBillingPeriod?
  /// Montant brut avant remise (optionnel ; sinon = amount + discount)
  baseAmount       Float?
  discountAmount   Float                 @default(0)
  catalogId        String?               @db.ObjectId
  catalog          TuitionFeeCatalog?    @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  scheduleTemplateId String?             @db.ObjectId
  scheduleTemplate   TuitionPaymentScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  /// Indice de versement si issu d’un gabarit (1, 2, …)
  installmentIndex Int?
  /// Numéro de facture attribué par l’administration (génération automatique ou manuelle)
  invoiceNumber     String?
  invoiceIssuedAt   DateTime?
  /// Dernière relance automatique (notification / e-mail) pour éviter le spam
  lastAutoReminderAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student  @relation(fields: [studentId], references: [id])
  payments      Payment[]

  @@index([studentId, academicYear])
  @@index([feeType])
  @@index([invoiceNumber])
  @@index([isPaid, dueDate])
  @@map("tuition_fees")
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  tuitionFeeId    String        @db.ObjectId
  studentId       String        @db.ObjectId
  payerId         String        @db.ObjectId // ID de l'utilisateur qui paie (élève ou parent)
  payerRole       Role          // Rôle de la personne qui paie
  amount          Float         // Montant payé en FCFA
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?       // ID de transaction du processeur de paiement
  paymentReference String?      // Référence de paiement unique
  /// Fournisseur : WAVE | ORANGE_MONEY | MTN_MOMO | CINETPAY | PAYSTACK | SANDBOX
  paymentProvider String?
  /// URL de redirection checkout (carte / agrégateur)
  checkoutUrl     String?
  receiptUrl      String?       // URL du reçu de paiement
  /// Numéro séquentiel officiel (ex. REC-2026-0001)
  receiptNumber     String?
  /// Code de vérification anti-falsification (page comptabilité)
  verificationCode  String?
  notes           String?       // Notes additionnelles
  paidAt          DateTime?     // Date de paiement effectif
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tuitionFee      TuitionFee    @relation(fields: [tuitionFeeId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  payer           User          @relation(fields: [payerId], references: [id])

  @@index([paymentProvider, status])
  @@index([receiptNumber])
  @@index([verificationCode])
  @@index([studentId])
  @@index([tuitionFeeId])
  @@index([status, createdAt])
  @@index([status, paidAt])
  @@map("payments")
}

/// Bourse ou aide financière accordée à un élève pour une année scolaire
model StudentScholarship {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String         @db.ObjectId
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear String
  label        String
  /// Remise fixe en FCFA (prioritaire sur percentOff si les deux sont renseignés)
  fixedAmount  Float?
  /// Remise en pourcentage (0–100)
  percentOff   Float?
  /// Limite au type de frais concerné (null = tous)
  feeType      SchoolFeeType?
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([studentId, academicYear, isActive])
  @@map("student_scholarships")
}

/// Catégories de dépenses (charges) pour le suivi budgétaire
enum SchoolExpenseCategory {
  SUPPLIES
  SERVICES
  UTILITIES
  MAINTENANCE
  PAYROLL_AUX
  TRANSPORT
  CATERING
  IT
  OTHER
}

enum PettyCashMovementType {
  IN
  OUT
}

enum CashRegisterType {
  PETTY
  COUNTER
  AUXILIARY
}

model CashRegister {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String?           @db.ObjectId
  code         String
  name         String
  type         CashRegisterType  @default(PETTY)
