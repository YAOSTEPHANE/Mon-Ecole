# Copier vers `.env` et renseigner les valeurs réelles.

# MongoDB (local ou Atlas). Si le mot de passe contient @ # ? etc., encoder en URL
# (@ → %40, : → %3A). Sinon Prisma résout un mauvais hôte (erreur DNS / 10051).
# Atlas : préférer l’URI « standard » (onglet Connect → Driver) si mongodb+srv échoue
# avec « DNS resolution » / querySrv ECONNREFUSED sous Windows.
DATABASE_URL="mongodb://localhost:27017/school_manager"

# JWT — obligatoire en production (chaîne assez longue, sans guillemets parasites)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
# Durée de session (cookie HttpOnly + JWT). Préférer 12h plutôt que 7d.
JWT_EXPIRES_IN=12h

# Cookie de session HttpOnly (sm_session). SameSite=none si front et API sur domaines différents (HTTPS requis).
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=1

# Chiffrement AES-256-GCM des champs élève sensibles en base (adresse, contact urgence, infos médicales).
# En production, obligatoire : le serveur refuse de démarrer sans cette clé.
# SENSITIVE_FIELD_ENCRYPTION_KEY=

PORT=5000
NODE_ENV=development

# Inscription publique (/auth/register).
# En production, elle est désactivée par défaut ; mettre true uniquement si l’école accepte
# la création libre de comptes élève/parent hors workflow d’admission.
# PUBLIC_ACCOUNT_REGISTRATION_ENABLED=false

# Vercel Blob — persistance des images / fichiers uploadés en production (Storage → Blob dans le projet Vercel).
# Injecté automatiquement sur Vercel quand un store Blob est lié. En local, optionnel pour tester le même flux :
# BLOB_READ_WRITE_TOKEN=

# Logs Prisma : ajouter query en dev uniquement si besoin de déboguer (sinon console saturée)
# PRISMA_LOG_QUERIES=true

# Derrière un reverse proxy (Vercel, nginx) pour le rate limiting par IP client
# TRUST_PROXY=1

# Origines autorisées pour CORS (Next.js) — le premier hôte sert aussi aux liens e-mail.
# Si le front et l’API sont derrière le même domaine HTTPS, incluez ce domaine (ex. https://ecole.example.org).
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# E-mail transactionnel (réinitialisation mot de passe, messages) — optionnel
# Gmail : smtp.gmail.com + port 587 + mot de passe d'application (pas le mdp du compte)
# SMTP_SECURE=true uniquement pour le port 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# RGPD — réception des demandes d’effacement / limitation (sinon utilise EMAIL_FROM)
# GDPR_CONTACT_EMAIL=privacy@votre-etablissement.fr

# Web Push (notifications navigateur) — générer avec : npx web-push generate-vapid-keys
# VAPID_SUBJECT : mailto: ou URL https du site (bonne pratique RFC)
# VAPID_PUBLIC_KEY copiable côté client via GET /api/push/vapid-public (pas besoin de NEXT_PUBLIC_*)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# SMS via Twilio — optionnel (numéros au format E.164, ex. +33612345678)


# Notifications automatiques aux parents lors du pointage (présence / absence)
# NOTIFY_PARENTS_ON_ATTENDANCE=false pour désactiver
# SCHOOL_NAME="Nom de l'établissement"

# Pointage enseignant / personnel — retard → notification ADMIN / SUPER_ADMIN
# ATTENDANCE_LATE_GRACE_MINUTES=10 — tolérance après l’heure prévue
# STAFF_WORK_START_TIME=08:00 — heure d’arrivée attendue du personnel admin (HH:MM)

# Pointage NFC / reconnaissance faciale (terminaux) — obligatoire en production (≥ 32 caractères, unique)
# Ne jamais exposer dans l’URL (?apiKey) : utiliser l’en-tête X-NFC-API-Key uniquement.
# NFC_API_KEY=

# --- Sauvegardes MongoDB (mongodump, MongoDB Database Tools sur le PATH) ---
# Incompatible Vercel / serverless (/var/task en lecture seule) : utiliser Atlas Backup ou un VPS / Render avec disque.
# Manuel : npm run backup:mongodb (depuis server/)
# Atlas : activer aussi les sauvegardes cloud dans le tableau de bord du cluster.
# ENABLE_SCHEDULED_MONGODB_BACKUPS=true — lance une sauvegarde selon le cron (processus API ; 1 seul worker en prod)
# MONGODB_BACKUP_CRON=0 3 * * * — défaut : tous les jours à 03:00
# MONGODB_BACKUP_DIR=backups/mongodb — dossier relatif au cwd ou chemin absolu
# MONGODB_BACKUP_RETENTION_DAYS=14 — suppression des archives plus anciennes après chaque sauvegarde
# MONGODB_BACKUP_MAX_UPLOAD_MB=1024 — taille max d’une archive importée pour restauration (interface admin)
# Restauration : Paramètres → Système (ADMIN / SUPER_ADMIN) ou POST /admin/security/backups/restore avec confirmPhrase=RESTAURER

# --- Relances automatiques frais de scolarité (notifications + e-mail si SMTP OK) ---
# ENABLE_SCHEDULED_TUITION_REMINDERS=true — désactivé par défaut ; 1 seul worker API en prod
# TUITION_REMINDERS_CRON=0 8 * * * — défaut : chaque jour à 08:00
# TUITION_REMINDER_MIN_INTERVAL_DAYS=7 — pas plus d’une relance auto par ligne de frais sur cette fenêtre
# SMS en plus pour les échéances déjà dépassées (parents avec notifySms=true et numéro valide, Twilio requis)
# TUITION_REMINDER_SMS_OVERDUE=false

# --- Rendez-vous parents-enseignants ---
# APPOINTMENTS_AUTO_CONFIRM=true — crée directement en CONFIRMED (sinon PENDING, validation enseignant)
# ENABLE_SCHEDULED_APPOINTMENT_REMINDERS=true — rappels ~24h et ~1h avant (désactivé par défaut ; 1 worker API en prod)
# APPOINTMENT_REMINDERS_CRON=*/15 * * * * — défaut : toutes les 15 minutes

# Annonce publiée en priorité « urgente » : SMS aux parents (en plus in-app / e-mail / push) si Twilio OK
# ANNOUNCEMENT_URGENT_SMS=false

# --- Présence journalière MENA (logiciel tiers / pointeurs) ---
# Secret webhook : POST /api/mena-presence/webhook (header X-Mena-Presence-Secret)
# Ou configurer via Admin → Intégrations (stockage chiffré en base).
# MENA_PRESENCE_WEBHOOK_SECRET=
# ENABLE_SCHEDULED_MENA_PRESENCE_IMPORT=true
# MENA_PRESENCE_IMPORT_CRON=15 18 * * *
# MENA_PRESENCE_WATCH_DIR=./imports/mena-presence
# MENA_PRESENCE_DB_URL=
# MENA_PRESENCE_DB_QUERY=

# --- Mobile Money / PSP (webhook opérateurs / agrégateurs) ---
# Secret attendu dans l’en-tête x-payment-webhook-secret (ou body.secret) sur :
#   POST /api/payments/webhooks/mobile-money
# Wave utilise Wave-Signature (HMAC SHA256) avec WAVE_WEBHOOK_SECRET ou WAVE_API_KEY.
# CinetPay vérifie la transaction via l’API check (pas ce secret).
# MTN : POST /api/payments/webhooks/mtn-momo
# Orange : POST /api/payments/webhooks/orange-money
# Paystack : x-paystack-signature (HMAC SHA512 avec PAYSTACK_SECRET_KEY).
# Sans clés live, les paiements restent en SANDBOX (confirmation économat).
# PAYMENT_WEBHOOK_SECRET=

# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_CLIENT_ID=
# ORANGE_MONEY_CLIENT_SECRET=
# ORANGE_MONEY_MERCHANT_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_TARGET_ENV=mtnivorycoast
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_NOTIFY_URL=https://votre-api.example.org/api/payments/webhooks/cinetpay
# PAYSTACK_SECRET_KEY=

# --- WhatsApp Cloud API (Meta) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v19.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=225
# WHATSAPP_VERIFY_TOKEN=choisis-une-chaine-secrete-longue
# Callback URL Meta (prod) : https://VOTRE_DOMAINE/api/webhooks/whatsapp
# Abonnements webhook : messages, message_status (message_template_status_update optionnel)

# --- Observabilité (Sentry optionnel) ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Assistant IA pédagogique (OpenAI-compatible, optionnel) ---
# Sans clé : réponses locales heuristiques. Avec clé : chat LLM.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- SSO Google / Microsoft (OAuth 2.0) ---
# URI de callback à enregistrer chez le fournisseur :
#   {OAUTH_API_PUBLIC_URL}/auth/oauth/google/callback
#   {OAUTH_API_PUBLIC_URL}/auth/oauth/microsoft/callback
# Ex. local : http://localhost:5000/api
# OAUTH_API_PUBLIC_URL=http://localhost:5000/api
# Les comptes doivent être préautorisés et liés au fournisseur par un administrateur.
# L’auto-création et la liaison automatique par simple correspondance d’e-mail sont désactivées.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Deep link app native Expo (scheme ecoleajour)
# MOBILE_OAUTH_REDIRECT_URI=ecoleajour://oauth

# --- LTI 1.3 (stub LMS) ---
# LTI_ISSUER=https://ecole.example.org
# LTI_CLIENT_ID=

# --- Visioconférence e-learning (Jitsi) ---
# Si l’URL de réunion est vide à la création d’une session, une salle est générée automatiquement.
# JITSI_BASE_URL=https://meet.jit.si
