/// Cycle de paie mensuel (enseignants, éducateurs, personnel)
enum PayrollRunStatus {
  DRAFT
  VALIDATED
  PAID
  CANCELLED
}

enum PayrollPersonKind {
  TEACHER
  EDUCATOR
  STAFF
}

model PayrollRun {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String           @db.ObjectId
  /// Année civile (ex. 2026)
  year             Int
  /// Mois 1–12
  month            Int
  status           PayrollRunStatus @default(DRAFT)
  /// Somme des salaires de base (brut de référence)
  totalBase        Float            @default(0)
  totalBonuses     Float            @default(0)
  totalDeductions  Float            @default(0)
  /// Somme des nets à payer
  totalNet         Float            @default(0)
  lineCount        Int              @default(0)
  notes            String?
  createdByUserId  String           @db.ObjectId
  validatedByUserId String?         @db.ObjectId
  validatedAt      DateTime?
  paidByUserId     String?          @db.ObjectId
  paidAt           DateTime?
  /// Dépense comptable créée au marquage « payé » (PAYROLL_AUX)
  schoolExpenseId  String?          @db.ObjectId
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lines PayrollLine[]

  @@unique([schoolId, year, month])
  @@index([schoolId, status])
  @@index([year, month])
  @@map("payroll_runs")
}

model PayrollLine {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  payrollRunId     String            @db.ObjectId
  personKind       PayrollPersonKind
  personId         String            @db.ObjectId
  userId           String            @db.ObjectId
  employeeId       String
  displayName      String
  contractType     String?
  engagementKind   String?
  /// Salaire de référence (mensuel) ou base calculée pour vacataire
  baseSalary       Float             @default(0)
  /// Heures pointées sur le mois (vacataires / suivi)
  hoursWorked      Float?
  /// Taux horaire dérivé (si applicable)
  hourlyRate       Float?
  bonuses          Float             @default(0)
  deductions       Float             @default(0)
  netAmount        Float             @default(0)
  /// Exclure de la paie sans supprimer la ligne
  included         Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId])
  @@index([personKind, personId])
  @@map("payroll_lines")
}

