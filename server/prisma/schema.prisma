  @@index([courseId, lessonDate])
  @@index([classId, lessonDate])
  @@index([teacherId, lessonDate])
  @@map("lesson_logs")
}

/// Examens physiques officiels (BEPC, BAC, contrôles…) — distinct des examens blancs MockExam
model PhysicalExamSession {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  examKind       String   // BEPC, BAC, CONTROLE, AUTRE
  subject        String?
  academicYear   String
  examDate       DateTime
  startTime      String   // HH:MM
  endTime        String   // HH:MM
  room           String?
  supervisorIds  String[] @default([])
  classIds       String[] @default([])
  schoolId       String?  @db.ObjectId
  notes          String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([academicYear, examDate])
  @@index([schoolId, examDate])
  @@map("physical_exam_sessions")
}

/// Taux d’admission officiels (CEPE, BEPC, BAC…) saisis par l’admin pour la vitrine publique.
model OfficialExamAdmissionStat {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  examKind      String
  examLabel     String
  academicYear  String
  candidates    Int?
  admitted      Int?
  passRate      Float
  displayOrder  Int      @default(0)
  isPublished   Boolean  @default(false)
  schoolId      String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, academicYear, isPublished])
  @@index([academicYear, isPublished])
  @@map("official_exam_admission_stats")
}

/// Publication du palmarès (1er de chaque classe) sur la page d’accueil.
model PublicHonorRollSetting {
  id           String   @id @map("_id")
  enabled      Boolean  @default(false)
  academicYear String?
  period       String?
  updatedAt    DateTime @updatedAt

  @@map("public_honor_roll_settings")
}

// ========== Écarts SI scolaire : alumni, parapheur, achats, CRM, LTI, patrimoine ==========

model AlumniProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String?  @db.ObjectId
  studentId       String?  @db.ObjectId
  firstName       String
  lastName        String
  email           String?
  phone           String?
  graduationYear  Int?
  currentJob      String?
  company         String?
  linkedInUrl     String?
  notes           String?
  newsletterOptIn Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eventRegs AlumniEventRegistration[]
  donations AlumniDonation[]

  @@index([schoolId, graduationYear])
  @@index([studentId])
  @@map("alumni_profiles")
}

model AlumniEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String?  @db.ObjectId
  title       String
  description String?
  eventDate   DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations AlumniEventRegistration[]

  @@index([schoolId, eventDate])
  @@map("alumni_events")
}

model AlumniEventRegistration {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId         String   @db.ObjectId
  alumniProfileId String   @db.ObjectId
  status          String   @default("REGISTERED")
  createdAt       DateTime @default(now())

  event   AlumniEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@unique([eventId, alumniProfileId])
  @@map("alumni_event_registrations")
}

model AlumniDonation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String?  @db.ObjectId
  alumniProfileId String?  @db.ObjectId
  amount          Float
  currency        String   @default("XOF")
  donatedAt       DateTime @default(now())
  note            String?
  createdAt       DateTime @default(now())

  profile AlumniProfile? @relation(fields: [alumniProfileId], references: [id], onDelete: SetNull)

  @@index([schoolId, donatedAt])
  @@map("alumni_donations")
}

enum SignatureDocType {
  REPORT_CARD
  CONTRACT
  AUTHORIZATION
  CERTIFICATE
  OTHER
}

enum SignatureRequestStatus {
  DRAFT
  PENDING
  SIGNED
  CANCELLED
  EXPIRED
}

model SignatureRequest {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String?                @db.ObjectId
  title        String
  documentType SignatureDocType       @default(OTHER)
  status       SignatureRequestStatus @default(DRAFT)
  targetUserId String?                @db.ObjectId
  studentId    String?                @db.ObjectId
  fileUrl      String?
  createdById  String                 @db.ObjectId
  expiresAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  actions SignatureAction[]

  @@index([schoolId, status])
  @@map("signature_requests")
}

model SignatureAction {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  requestId     String    @db.ObjectId
  signerUserId  String    @db.ObjectId
  signerRole    String?
  signedAt      DateTime?
  signatureData String?
  ip            String?
  status        String    @default("PENDING")

  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([signerUserId])
  @@map("signature_actions")
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  CANCELLED
}

model ProcurementRequest {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String?           @db.ObjectId
  title            String
  description      String?
  category         String?
  estimatedAmount  Float?
  status           ProcurementStatus @default(DRAFT)
  requestedById    String            @db.ObjectId
  approvedById     String?           @db.ObjectId
  supplierId       String?           @db.ObjectId
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  bids ProcurementBid[]

  @@index([schoolId, status])
  @@map("procurement_requests")
}

model ProcurementBid {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  requestId   String   @db.ObjectId
  vendorName  String
  amount      Float
  notes       String?
  submittedAt DateTime @default(now())
  selected    Boolean  @default(false)

  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("procurement_bids")
}

enum MarketingChannel {
  EMAIL
  SMS
  WHATSAPP
  MIXED
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model MarketingCampaign {
  id             String                   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String?                  @db.ObjectId
  name           String
  channel        MarketingChannel         @default(EMAIL)
  status         MarketingCampaignStatus  @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  messageBody    String
  audienceFilter Json?
  stats          Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  recipients CampaignRecipient[]

  @@index([schoolId, status])
  @@map("marketing_campaigns")
}

model CampaignRecipient {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String    @db.ObjectId
  leadId     String?   @db.ObjectId
  parentId   String?   @db.ObjectId
  status     String    @default("PENDING")
  sentAt     DateTime?

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     PublicContactLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@map("campaign_recipients")
}

model LtiPlatformConfig {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String?  @db.ObjectId
  enabled       Boolean  @default(false)
  issuer        String
  clientId      String
  deploymentId  String?
  keysetUrl     String?
  redirectUris  String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@map("lti_platform_configs")
}

model LtiLaunch {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String?  @db.ObjectId
  userId         String?  @db.ObjectId
  resourceLinkId String?
  targetLinkUri  String?
  launchedAt     DateTime @default(now())
  rawClaims      Json?

  @@index([schoolId, launchedAt])
  @@map("lti_launches")
}

model ScormPackage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String?  @db.ObjectId
  title      String
  version    String?  @default("1.2")
  entryUrl   String
  uploadedAt DateTime @default(now())
  active     Boolean  @default(true)

  @@index([schoolId, active])
  @@map("scorm_packages")
}

enum EstateAssetCategory {
  LAND
  BUILDING
  VEHICLE
  FURNITURE
  OTHER
}

model EstateBuilding {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String?  @db.ObjectId
  name       String
  code       String?
  address    String?
  floors     Int?
  yearBuilt  Int?
  areaSqm    Float?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets EstateAsset[]

  @@index([schoolId, active])
  @@map("estate_buildings")
}

model EstateAsset {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  buildingId      String?             @db.ObjectId
  schoolId        String?             @db.ObjectId
  name            String
  category        EstateAssetCategory @default(OTHER)
  value           Float?
  acquisitionDate DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  building EstateBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([buildingId])
  @@map("estate_assets")
}

