{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NEXT_PUBLIC_EXPRESS_UPLOADS_VIA_API_PREFIX": "1",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "installCommand": "npm install && npm install --prefix web && npm install --prefix server",
  "experimentalServices": {
    "web": {
      "root": "web",
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "server",
      "entrypoint": "index.cjs",
      "routePrefix": "/api",
      "framework": "express",
      "buildCommand": "npm run build",
      "includeFiles": [
        "prisma/**",
        "prisma-bridge.cjs",
        "lambda-node_modules/**",
        "dist/prisma-bridge.cjs",
        "dist/lambda-node_modules/**"
      ]
    }
  }
}
