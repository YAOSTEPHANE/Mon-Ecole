{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint; node -e \"process.exit(0)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:exports": "cd ../server && npm run test:web-exports"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "@sentry/nextjs": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "react-is": "$react-is",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
