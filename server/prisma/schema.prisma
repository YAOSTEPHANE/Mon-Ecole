enum PublicVisitorEventType {
  PAGE_VIEW
  CONTACT_LEAD_SUBMIT
  ADMISSION_SUBMIT
  ADMISSION_TRACK
  RECOMMENDATION_REQUEST
  CHAT_THREAD_CREATE
  CHAT_MESSAGE_SUBMIT
}

model PublicVisitor {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  visitorId     String    @unique
  // userId est optionnel (quand un visiteur crée ensuite un compte)
  // On ne déclare pas de relation Prisma ici pour éviter d’ajouter des champs opposés
  // côté modèle `User`.
  userId        String?   @db.ObjectId
  schoolId      String?   @db.ObjectId
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Contexte technique / géo (approximatif via IP — pas de GPS)
  lastIp         String?
  countryCode    String?
  country        String?
  region         String?
  city           String?
  userAgent      String?
  deviceType     String?   // desktop | mobile | tablet | bot | unknown
  browser        String?
  os             String?
  language       String?
  timezone       String?

  events        PublicVisitorEvent[]
  contactLeads  PublicContactLead[]
  chatThreads   PublicChatThread[]

  @@index([lastSeenAt])
  @@map("public_visitors")
}

model PublicVisitorEvent {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
