enum TransportCheckInType {
  BOARD
  DROPOFF
}

model TransportCheckIn {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  routeId           String               @db.ObjectId
  route             TransportRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
