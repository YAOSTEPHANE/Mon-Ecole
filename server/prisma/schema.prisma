  prompt        String
  options       Json?
  correctAnswer String
  points        Int                   @default(1)
  sortOrder     Int                   @default(0)

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)

  @@index([mockExamId])
  @@map("mock_exam_questions")
}

model MockExamAttempt {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  mockExamId  String    @db.ObjectId
  studentId   String    @db.ObjectId
  answers     Json
  score       Float?
  maxScore    Float?
  scoreOn20   Float?
  passed      Boolean?
  gradeId     String?   @db.ObjectId
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  tabSwitchCount   Int      @default(0)
  fullscreenExits  Int      @default(0)
  proctoringFlags  String[] @default([])
  integrityScore   Float?

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
