{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NEXT_PUBLIC_EXPRESS_UPLOADS_VIA_API_PREFIX": "1"
  },
  "installCommand": "npm install && npm install --prefix web && npm install --prefix server",
  "experimentalServices": {
    "web": {
      "root": "web",
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "server",
      "entrypoint": "vercel-api.cjs",
      "routePrefix": "/api",
      "framework": "express",
      "buildCommand": "npx prisma generate && node ./scripts/bundle-for-vercel.mjs",
      "includeFiles": [
        "prisma/**",
        "node_modules/@prisma/**",
        "node_modules/.prisma/**"
      ]
    }
  }
}
