{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "env": {
    "NEXT_PUBLIC_EXPRESS_UPLOADS_VIA_API_PREFIX": "1",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "server",
      "entrypoint": "index.cjs",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "functions": {
        "index.cjs": {
          "includeFiles": "{prisma/**,prisma-bridge.cjs,lambda-node_modules/**,dist/prisma-bridge.cjs,dist/lambda-node_modules/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
