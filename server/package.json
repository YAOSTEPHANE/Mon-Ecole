{
  "name": "school-manager-server",
  "version": "1.0.0",
  "description": "Backend API pour School Manager App",
  "type": "module",
  "main": "index.cjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node ./scripts/write-dist-package-cjs.mjs && node ./scripts/prepare-vercel-runtime-deps.mjs",
    "start": "node dist/vercel-entry.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "backup:mongodb": "tsx scripts/mongodb-backup.ts",
    "backfill:digital-card-ids": "tsx scripts/backfill-student-digital-card-public-ids.ts",
    "test": "node --import tsx --test src/utils/password.util.test.ts src/utils/secure-compare.util.test.ts src/utils/school-access-guard.util.test.ts src/utils/staff-module-admin-access.util.test.ts src/utils/upload-file-path.util.test.ts src/utils/upload-access-token.util.test.ts src/utils/admission-upload.util.test.ts src/utils/blob-storage.util.test.ts src/utils/course-fields.util.test.ts src/utils/mongodb-backup.util.test.ts src/utils/user-ui-preferences.util.test.ts src/utils/platform-extensions.util.test.ts src/utils/mock-exam.util.test.ts src/utils/accounting-cash.util.test.ts src/utils/payroll.util.test.ts src/utils/student-csv-import.util.test.ts src/utils/school-operations.util.test.ts",
    "test:school-operations": "tsx scripts/test-school-operations-modules.ts",
    "test:persistence": "tsx scripts/test-all-persistence.ts",
    "test:persistence:ops": "tsx scripts/test-school-operations-persistence.ts",
    "test:integration": "tsx scripts/test-security-policies.ts",
    "test:spaces": "tsx scripts/test-all-spaces-modules.ts",
    "test:repair-db": "tsx scripts/repair-orphan-academic-records.ts",
    "clear:schedules": "tsx scripts/clear-all-schedules.ts",
    "clear:courses": "tsx scripts/clear-all-courses.ts",
    "clear:except-users": "tsx scripts/clear-database-except-users.ts",
    "restore:tranlefet-personnel": "tsx scripts/restore-tranlefet-personnel.ts",
    "restore:tranlefet-library": "tsx scripts/restore-tranlefet-library.ts",
    "test:import-export": "tsx scripts/test-import-export-documents.ts",
    "test:staff-modules": "tsx scripts/test-staff-module-display.ts",
    "test:staff-admissions": "tsx scripts/test-staff-admissions-api.ts",
    "test:bursar": "tsx scripts/test-bursar-finance-modules.ts",
    "test:extended": "npm run test:repair-db && npm run test:staff-modules && npm run test:staff-admissions && npm run test:bursar",
    "test:smtp": "tsx scripts/test-smtp.ts",
    "test:web-exports": "tsx --test ../web/src/lib/document-exports.test.ts ../web/src/lib/offline-sync-queue.test.ts ../web/src/lib/accountingJournal.test.ts ../web/src/lib/classFinancialSituation.test.ts ../web/src/lib/tuitionBilling.test.ts ../web/src/lib/gradeEvaluationGroups.test.ts src/utils/tuition-fee-billing.util.test.ts src/utils/teacher-session-timing.util.test.ts",
    "test:all": "npm run test && npm run build && npm run test:web-exports && npm run test:repair-db && npm run test:integration && npm run test:spaces && npm run test:import-export && npm run test:extended"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.65.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "undici": "^8.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
