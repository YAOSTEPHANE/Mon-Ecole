  schoolId          String?              @db.ObjectId
  pageUrl           String?
  referrerUrl       String?
  admissionReference String?
  chatThreadId      String?             @db.ObjectId
  metadata          Json?
  createdAt         DateTime            @default(now())

  @@index([publicVisitorId, createdAt])
  @@index([eventType, createdAt])
  @@map("public_visitor_events")
}

