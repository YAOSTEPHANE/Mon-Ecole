/// Demande d'inscription / pré-admission (dossier candidat)
model Admission {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  reference        String          @unique
  status           AdmissionStatus @default(PENDING)
  schoolId         String?         @db.ObjectId

  firstName        String
  lastName         String
  /// Matricule déclaré par la famille (établissement précédent ou national), si connu
  matricule        String?
  email            String
  phone            String?
  dateOfBirth      DateTime
  birthPlace       String?
  isRepeating      Boolean         @default(false)
  gender           Gender

  desiredLevel     String
  academicYear     String
  previousSchool   String?

  parentName       String?
  parentPhone      String?
  parentEmail      String?
  address          String?

  motivation       String?
  adminNotes       String?

  /// Moyennes (2nde, 1ère, Terminale) — formulaire d'inscription en ligne
  gradeTerm1                 Float?
  gradeTerm2                 Float?
  gradeAnnualGeneral         Float?
  gradeAnnualSpecific        Float?
  gradeAnnualLiterary        Float?

  /// Bulletin du 3e trimestre (PDF / image) — inscription en ligne lycée
  term3ReportCardUrl         String?
  term3ReportCardOriginalName String?
  term3ReportCardMimeType    String?

  proposedClassId  String?   @db.ObjectId
  proposedClass    Class?    @relation(fields: [proposedClassId], references: [id])
  school           School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  enrolledStudentId String?  @db.ObjectId

  reviewedById     String?   @db.ObjectId
  reviewedAt       DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([academicYear])
  @@index([email])
  @@index([matricule])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([enrolledStudentId])
  @@map("admissions")
}

/// Établissement scolaire (collège / lycée) — périmètre multi-sites
model School {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  shortName       String?
  address         String?
  phone           String?
  email           String?
  website         String?
  principalName   String?
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         SchoolMember[]
  classes         Class[]
  students        Student[]
  admissions      Admission[]
  staffMembers    StaffMember[]
  staffMetiers    SchoolStaffMetier[]
  healthCampaigns HealthCampaign[]
  workspaces      AdminWorkspace[]
  branding        AppBranding?
  menaTransmissions MenaTransmission[]
  announcements   Announcement[]
  libraryBooks    LibraryBook[]
  materialRooms   MaterialRoom[]
  materialEquipment MaterialEquipment[]
  disciplinaryRulebooks SchoolDisciplinaryRulebook[]
  disciplinaryRecords   StudentDisciplinaryRecord[]
  tuitionFeeCatalogs    TuitionFeeCatalog[]

  @@index([isActive])
  @@index([isDefault])
  @@map("schools")
}

/// Historique des dossiers élèves préparés / envoyés vers le MENA (DESPS / SIGE / FNE).
model MenaTransmission {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String   @db.ObjectId
  academicYear     String?
  status           String
  /// EXPORT | WEBHOOK | BOTH
  channel          String
  studentCount     Int      @default(0)
  packageChecksum  String?
  /// Résumé (pas forcément le payload complet si très volumineux)
  summary          Json?
  /// Payload complet du dossier (JSON)
  payload          Json?
  errorMessage     String?
  webhookUrlMasked String?
  webhookHttpStatus Int?
  createdByUserId  String?  @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("mena_transmissions")
}

/// Métier du personnel de soutien (STAFF) configuré par établissement — les admins restent globaux (AdminWorkspace).
model SchoolStaffMetier {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String           @db.ObjectId
  supportKind    SupportStaffKind
  /// Libellé affiché (sinon libellé plateforme par défaut)
  label          String?
  description    String?
  /// Modules par défaut pour ce métier dans cet établissement
  defaultModules String[]         @default([])
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, supportKind])
  @@index([schoolId, isActive])
  @@map("school_staff_metiers")
}

/// Accès d’un utilisateur à un ou plusieurs établissements
